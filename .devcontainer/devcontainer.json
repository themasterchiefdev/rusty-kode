{
  "name": "rusty-kode",
  "image": "mcr.microsoft.com/devcontainers/rust:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "containerEnv": {
    "RUST_BACKTRACE": "1"
  },
  "postCreateCommand": "rustup component add rustfmt clippy && rustc --version && cargo --version && rustfmt --version && cargo clippy --version",
  "remoteUser": "vscode"
}
